# Public Firebase Web SDK config. Never put a service-account private key here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Server-only settings, never use the VITE_ prefix for these.
RTG_FIREBASE_PROJECT_ID=
RTG_FIREBASE_CLIENT_EMAIL=
# Full PEM private_key; literal \n or actual newlines are supported.
RTG_FIREBASE_PRIVATE_KEY=

# Optional legacy alternatives: local file path or complete JSON.
RTG_SERVICE_ACCOUNT_PATH=
RTG_SERVICE_ACCOUNT_JSON=
